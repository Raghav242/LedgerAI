# Copy to .env for local development:  Copy-Item .env.example .env
# The passwords below are NON-SECRET local development defaults. Never reuse them anywhere
# real. The two values left EMPTY (LAB_TRAFFIC_SECRET, RABBITMQ_MONITOR_PASSWORD) must be
# generated on your machine -- see "Secrets" below. .env is gitignored; never commit it.
# The same file feeds docker-compose.yml (stack) and a locally run uvicorn (debugging).

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Development-only surface: POST /api/v1/accounts/{id}/fund (mints simulated money), the
# Experiment Lab, live topology, AI results and Performance Lab. Refused at startup when
# APP_ENV=production, when NGINX_BIND is not a loopback address, or without LAB_TRAFFIC_SECRET.
ENABLE_DEV_ENDPOINTS=true
DB_ECHO=false
# Development aid: add X-Served-By (replica id) to every response.
EXPOSE_REPLICA_HEADER=true
# Max wait (ms) for a row lock or an in-flight same-key request before a transfer
# fails with a retryable 503 CONCURRENCY_CONFLICT / 409 IDEMPOTENCY_REQUEST_IN_PROGRESS.
TRANSFER_LOCK_TIMEOUT_MS=3000

# --- Connection pool (per API process) ---
# A locally run uvicorn uses these. Compose replicas use API_DB_POOL_SIZE /
# API_DB_MAX_OVERFLOW (default 5 + 5 each) so 4 replicas stay far below max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# --- PostgreSQL (used by both docker-compose.yml and the app) ---
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=ledgerflow_dev_password
# 127.0.0.1, not "localhost": on Windows "localhost" tries IPv6 ::1 first, which
# hangs against Docker Desktop's IPv4-only port binding.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ledgerflow
# Separate database for integration tests (created automatically by the test suite).
POSTGRES_TEST_DB=ledgerflow_test
# Least-privilege RUNTIME role (Phase 6B) that the API replicas and workers connect as.
# The `migrate` job creates it and grants exactly what each table needs (ledger and audit
# tables are INSERT-only). POSTGRES_USER above is the schema-owning MIGRATION role.
# Non-secret development default; must differ from POSTGRES_PASSWORD.
APP_DB_USER=ledgerflow_app
APP_DB_PASSWORD=ledgerflow_app_dev_password

# --- Redis rate limiting ---
# Compose replicas always use redis://redis:6379/0 internally. A locally run uvicorn
# uses the stack's Redis through its loopback port: docker compose up -d --wait redis
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_MS=250
REDIS_SOCKET_TIMEOUT_MS=250
# Token buckets shared by all replicas (write = POST routes, fails CLOSED if Redis is down;
# read = GET routes, fails OPEN). burst = capacity, sustained = refill_tokens per interval.
RATE_LIMIT_WRITE_CAPACITY=20
RATE_LIMIT_WRITE_REFILL_TOKENS=10
RATE_LIMIT_WRITE_REFILL_INTERVAL_MS=1000
RATE_LIMIT_READ_CAPACITY=100
RATE_LIMIT_READ_REFILL_TOKENS=50
RATE_LIMIT_READ_REFILL_INTERVAL_MS=1000

# --- Experiment Lab (Phase 5B; only with ENABLE_DEV_ENDPOINTS=true) ---
# Where the lab runner sends measured traffic. Compose sets http://nginx:8080 for the
# replicas; a locally run uvicorn (default) targets itself.
# LAB_TARGET_BASE_URL=http://127.0.0.1:8000

# --- Secrets (generate locally; REQUIRED values are marked) ---
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED when ENABLE_DEV_ENDPOINTS=true: HMAC key that marks Experiment Lab traffic.
# At least 32 characters, independent of every password here (there is no fallback).
# It authenticates the lab runner to the replicas -- it is NOT user authentication.
LAB_TRAFFIC_SECRET=
# Optional: password of the least-privilege RabbitMQ monitoring user (created by the
# rabbitmq-monitor-setup job; tag `monitoring`, permissions that match nothing). With it,
# the live topology probes the broker and its dead-letter queues independently of the
# workers. Empty = no independent probe. Must differ from RABBITMQ_PASSWORD.
RABBITMQ_MONITOR_PASSWORD=
# RABBITMQ_MONITOR_USER=ledgerflow_monitor

# --- RabbitMQ (outbox publisher + event consumer; the API never talks to the broker) ---
# Admin credentials: held only by the workers and the monitor-setup job, never the API.
RABBITMQ_USER=ledgerflow
RABBITMQ_PASSWORD=ledgerflow_dev_password
# Host-side access (tests, demos, a locally run publisher/consumer). Containers use rabbitmq:5672.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
CONSUMER_PREFETCH=10

# --- Stack networking (only change if these collide with something on your machine) ---
# NGINX_PORT=8080
# Publishing on anything but loopback (e.g. 0.0.0.0) requires ENABLE_DEV_ENDPOINTS=false.
# NGINX_BIND=127.0.0.1
# BACKEND_NET=172.28.0   (first three octets of the internal /24 network)
# Benchmark stack (separate Compose project ledgerflow-bench), if 172.29.0.x collides:
# LEDGERFLOW_BENCH_NET=172.29.0
# Stack-test project (ledgerflow-stacktest), if 172.30.0.x collides:
# LEDGERFLOW_STACKTEST_NET=172.30.0
# Containerized frontend (production build): http://127.0.0.1:3000
# FRONTEND_PORT=3000

# --- Retention (docker compose --profile maintenance run --rm retention) ---
# Only lab runs and stale worker heartbeats are ever pruned; never money or audit rows.
# RETENTION_LAB_RUN_DAYS=30
# RETENTION_HEARTBEAT_DAYS=7
