# Copy to .env for local development:  Copy-Item .env.example .env
# These are NON-SECRET local development defaults. Never reuse them anywhere real.
# The same file feeds docker-compose.yml (stack) and a locally run uvicorn (debugging).

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Exposes POST /api/v1/accounts/{id}/fund (mints simulated money).
# Must stay false in any shared or public deployment; it is rejected when APP_ENV=production.
ENABLE_DEV_ENDPOINTS=true
DB_ECHO=false
# Development aid: add X-Served-By (replica id) to every response.
EXPOSE_REPLICA_HEADER=true
# Max wait (ms) for a row lock or an in-flight same-key request before a transfer
# fails with a retryable 503 CONCURRENCY_CONFLICT / 409 IDEMPOTENCY_REQUEST_IN_PROGRESS.
TRANSFER_LOCK_TIMEOUT_MS=3000

# --- Connection pool (per API process) ---
# A locally run uvicorn uses these. Compose replicas use API_DB_POOL_SIZE /
# API_DB_MAX_OVERFLOW (default 5 + 5 each) so 4 replicas stay far below max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# --- PostgreSQL (used by both docker-compose.yml and the app) ---
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=ledgerflow_dev_password
# 127.0.0.1, not "localhost": on Windows "localhost" tries IPv6 ::1 first, which
# hangs against Docker Desktop's IPv4-only port binding.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ledgerflow
# Separate database for integration tests (created automatically by the test suite).
POSTGRES_TEST_DB=ledgerflow_test

# --- Redis rate limiting ---
# Compose replicas always use redis://redis:6379/0 internally. A locally run uvicorn
# uses the stack's Redis through its loopback port: docker compose up -d --wait redis
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_MS=250
REDIS_SOCKET_TIMEOUT_MS=250
# Token buckets shared by all replicas (write = POST routes, fails CLOSED if Redis is down;
# read = GET routes, fails OPEN). burst = capacity, sustained = refill_tokens per interval.
RATE_LIMIT_WRITE_CAPACITY=20
RATE_LIMIT_WRITE_REFILL_TOKENS=10
RATE_LIMIT_WRITE_REFILL_INTERVAL_MS=1000
RATE_LIMIT_READ_CAPACITY=100
RATE_LIMIT_READ_REFILL_TOKENS=50
RATE_LIMIT_READ_REFILL_INTERVAL_MS=1000

# --- Stack networking (only change if these collide with something on your machine) ---
# NGINX_PORT=8080
# NGINX_BIND=127.0.0.1
# BACKEND_NET=172.28.0   (first three octets of the internal /24 network)
