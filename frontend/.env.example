# Frontend configuration (copy to .env.local to override). No secrets belong here:
# every VITE_* value is compiled into the public JavaScript bundle.

# Where the Vite dev/preview server proxies /api and /health (the NGINX gateway).
# Read by vite.config.ts only; never shipped to the browser.
LEDGERFLOW_API_PROXY_TARGET=http://127.0.0.1:8080

# Base URL the browser uses for API calls. Empty = same origin (through the proxy).
VITE_API_BASE_URL=

# Per-request timeout in milliseconds.
VITE_API_TIMEOUT_MS=10000
